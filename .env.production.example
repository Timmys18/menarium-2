# Menarium production runtime settings.
# Store real values in the protected GitHub Environment secret APP_ENV_FILE_CONTENTS.

NODE_ENV=production
APP_RELEASE=set-by-release-workflow
APP_ENVIRONMENT=production

# Public application URLs
NEXTAUTH_URL=https://menarium.ru
APP_URL=https://menarium.ru
NEXTAUTH_SECRET=generate-a-long-random-secret-here

# PostgreSQL and Redis must be reachable from the application container.
DATABASE_URL=postgresql://user:password@host:5432/menarium?schema=public
REDIS_URL=redis://:password@host:6379

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@menarium.ru

# Privacy-first, first-party product analytics
PRODUCT_ANALYTICS_ENABLED=true
PRODUCT_ANALYTICS_RETENTION_DAYS=180

# S3-compatible object storage is mandatory in production.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://storage.yandexcloud.net
STORAGE_BUCKET=menarium-media
STORAGE_REGION=ru-central1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://menarium-media.storage.yandexcloud.net

# Transactional email
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Menarium <noreply@menarium.ru>

# Error monitoring
SENTRY_DSN=https://public-key@your-sentry-host/1
NEXT_PUBLIC_SENTRY_DSN=https://public-key@your-sentry-host/1
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
