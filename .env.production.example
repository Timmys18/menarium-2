# Menarium 2.0 — production environment template
# Copy to your server secrets manager or .env.production (never commit real values).

NODE_ENV=production

# App URLs
NEXTAUTH_URL=https://menarium.ru
NEXT_PUBLIC_APP_URL=https://menarium.ru
NEXTAUTH_SECRET=generate-a-long-random-secret-here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/menarium?schema=public

# Redis (rate limits in production)
REDIS_URL=redis://:password@host:6379

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@menarium.ru

# Object storage — use s3 in production
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://storage.yandexcloud.net
STORAGE_BUCKET=menarium-media
STORAGE_REGION=ru-central1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://menarium-media.storage.yandexcloud.net

# Email (password reset + email verification)
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Menarium <noreply@menarium.ru>

# Error monitoring (required for production visibility; DSN is not a secret)
SENTRY_DSN=https://public-key@your-sentry-host/1
NEXT_PUBLIC_SENTRY_DSN=https://public-key@your-sentry-host/1
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
