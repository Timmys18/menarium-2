# PostgreSQL source
DATABASE_URL=postgresql://backup_user:password@database-host:5432/menarium

# Off-site S3 destination. Use a separate bucket/account from application media.
BACKUP_S3_URI=s3://menarium-backups/production
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_SSE_MODE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1

# Public age recipient. Keep the matching private identity offline.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_STATE_DIR=/opt/menarium/state/backups
