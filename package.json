    "@fontsource-variable/onest": "^5.2.11",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.64.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next": "16.2.7",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
