{
  "name": "menarium-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "analytics:prune": "node scripts/prune-product-events.mjs",
    "release:check": "node scripts/check-migration-safety.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "preview:full": "node scripts/start-full-preview.mjs",
    "preview:setup": "node scripts/start-full-preview.mjs",
    "verify": "npm run release:check && npm run lint && npm run test && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
