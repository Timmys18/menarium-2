# База данных
DATABASE_URL="postgresql://menarium:menarium@localhost:5433/menarium"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="замените-на-длинный-случайный-секрет"

# Redis (опционально — без него rate-limit работает в памяти)
REDIS_URL="redis://localhost:6379"

# Число доверенных прокси перед приложением (локально прокси нет).
# TRUSTED_PROXY_HOPS=1

# Медиа: local или s3
STORAGE_PROVIDER="local"
STORAGE_PUBLIC_BASE_URL="http://localhost:3000/uploads"

# S3 (если STORAGE_PROVIDER=s3)
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Почта (для сброса пароля и подтверждения email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Menarium <noreply@menarium.ru>"

# Браузерные уведомления
# WEB_PUSH_SUBJECT="mailto:support@menarium.ru"
# NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=

# Мониторинг ошибок (опционально)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
