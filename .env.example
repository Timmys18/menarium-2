NODE_ENV=development

# PostgreSQL
# Docker local default from docker-compose.local.yml:
# DATABASE_URL="postgresql://menarium:menarium_local_password@localhost:5432/menarium2?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menarium2?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAILS="admin@menarium.ru"

# Redis is required in production for rate limits.
# In development, missing REDIS_URL disables persistent rate limiting.
REDIS_URL="redis://localhost:6379"

# Public domain for production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage provider: local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./public/uploads"
STORAGE_PUBLIC_BASE_URL="/uploads"

# S3-compatible storage, for example Yandex Object Storage.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION="ru-central1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
