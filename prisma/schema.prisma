generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  THING
  SERVICE
}

enum ItemStatus {
  ACTIVE
  PAUSED
  IN_DEAL
  ARCHIVED
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  SWAP_RECEIVED
  SWAP_ACCEPTED
  SWAP_DECLINED
  SWAP_CANCELLED
  SWAP_COMPLETED
  DEAL_MESSAGE_RECEIVED
  ITEM_MESSAGE_RECEIVED
  REVIEW_PUBLISHED
  HANDOFF_UPDATED
  REPORT_UPDATED
}

enum HandoffMode {
  IN_PERSON
  DELIVERY
  ONLINE
}

enum MediaOwnerType {
  ITEM
  USER
  CHAT
}

enum ChatKind {
  DEAL
  ITEM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ReportTargetType {
  USER
  ITEM
}

enum ReportReason {
  FRAUD
  SPAM
  HARASSMENT
  PROHIBITED_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  city             String?
  cityId           String?
  status           UserStatus @default(ACTIVE)
  sessionVersion   Int        @default(0)
  deletedAt        DateTime?
  suspendedAt      DateTime?
  suspensionReason String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  accounts           Account[]
  sessions           Session[]
  items              Item[]
  sentSwaps          SwapRequest[]       @relation("SwapSender")
  receivedSwaps      SwapRequest[]       @relation("SwapReceiver")
  dealMessages       DealMessage[]
  itemThreadsAsBuyer ItemThread[]        @relation("ItemThreadBuyer")
  itemThreadsAsOwner ItemThread[]        @relation("ItemThreadOwner")
  itemMessages       ItemThreadMessage[]
  notifications      Notification[]
  mediaAssets        MediaAsset[]
  swipePasses        SwipePass[]
  blocksCreated      UserBlock[]         @relation("Blocker")
  blocksReceived     UserBlock[]         @relation("Blocked")
  reportsFiled       Report[]            @relation("ReportsFiled")
  reportsReceived    Report[]            @relation("ReportedUser")
  reportsResolved    Report[]            @relation("ReportResolver")
  reviewsWritten     Review[]            @relation("ReviewAuthor")
  reviewsReceived    Review[]            @relation("ReviewRecipient")
  favorites          Favorite[]
  itemViews          ItemView[]
  productEvents      ProductEvent[]
  pushSubscriptions  PushSubscription[]
  chatPreferences    ChatPreference[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([cityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id              String     @id @default(cuid())
  title           String
  type            ItemType
  category        String
  categoryId      String?
  description     String     @db.Text
  city            String
  cityId          String?
  isOnline        Boolean    @default(false)
  status          ItemStatus @default(ACTIVE)
  desired         String[]   @default([])
  acceptsAnything Boolean    @default(false)
  extraOfferText  String?    @db.Text
  ownerId         String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        MediaAsset[]
  sentSwaps     SwapRequest[] @relation("SenderItem")
  receivedSwaps SwapRequest[] @relation("ReceiverItem")
  threads       ItemThread[]
  swipePasses   SwipePass[]
  reports       Report[]
  favorites     Favorite[]
  views         ItemView[]

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@index([category, status])
  @@index([categoryId, status])
  @@index([city, status])
  @@index([cityId, status])
  @@index([type, status])
}

model SwipePass {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId, createdAt])
}

model SwapRequest {
  id                       String       @id @default(cuid())
  status                   SwapStatus   @default(PENDING)
  senderId                 String
  receiverId               String
  senderItemId             String
  receiverItemId           String
  senderCompleted          Boolean      @default(false)
  receiverCompleted        Boolean      @default(false)
  acceptedAt               DateTime?
  completedAt              DateTime?
  expiresAt                DateTime     @default(dbgenerated("now() + interval '7 days'"))
  handoffMode              HandoffMode?
  handoffScheduledAt       DateTime?
  handoffDetails           String?      @db.Text
  handoffRevision          Int          @default(0)
  senderHandoffConfirmed   Boolean      @default(false)
  receiverHandoffConfirmed Boolean      @default(false)
  /// Directional while pending: the reverse offer is allowed and creates a match.
  pendingPairKey           String?      @unique
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  sender       User          @relation("SwapSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User          @relation("SwapReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  senderItem   Item          @relation("SenderItem", fields: [senderItemId], references: [id], onDelete: Restrict)
  receiverItem Item          @relation("ReceiverItem", fields: [receiverItemId], references: [id], onDelete: Restrict)
  messages     DealMessage[]
  reviews      Review[]
  reports      Report[]

  @@index([senderId, status, updatedAt])
  @@index([receiverId, status, updatedAt])
  @@index([senderItemId, status])
  @@index([receiverItemId, status])
  @@index([status, updatedAt])
  @@index([status, completedAt])
  @@index([status, expiresAt])
}

model Review {
  id         String   @id @default(cuid())
  swapId     String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?  @db.Text
  visibleAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  swap     SwapRequest @relation(fields: [swapId], references: [id], onDelete: Cascade)
  reviewer User        @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User        @relation("ReviewRecipient", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([swapId, reviewerId])
  @@index([revieweeId, visibleAt, createdAt])
  @@index([reviewerId, createdAt])
  @@index([swapId])
}

model Favorite {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId, createdAt])
  @@index([itemId, createdAt])
}

model ItemView {
  userId   String
  itemId   String
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId, viewedAt])
  @@index([itemId, viewedAt])
}

model DealMessage {
  id        String    @id @default(cuid())
  swapId    String
  senderId  String
  text      String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  replyToId String?
  createdAt DateTime  @default(now())

  swap        SwapRequest   @relation(fields: [swapId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     DealMessage?  @relation("DealMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     DealMessage[] @relation("DealMessageReplies")
  attachments MediaAsset[]  @relation("DealMessageMedia")

  @@index([swapId, createdAt])
  @@index([swapId, isRead, createdAt])
  @@index([replyToId])
}

model ItemThread {
  id        String   @id @default(cuid())
  itemId    String
  buyerId   String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item     Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer    User                @relation("ItemThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  owner    User                @relation("ItemThreadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages ItemThreadMessage[]

  @@unique([itemId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([ownerId, updatedAt])
}

model ItemThreadMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  text      String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  replyToId String?
  createdAt DateTime  @default(now())

  thread      ItemThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     ItemThreadMessage?  @relation("ItemThreadMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ItemThreadMessage[] @relation("ItemThreadMessageReplies")
  attachments MediaAsset[]        @relation("ItemThreadMessageMedia")

  @@index([threadId, createdAt])
  @@index([threadId, isRead, createdAt])
  @@index([replyToId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  href       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model MediaAsset {
  id                  String         @id @default(cuid())
  ownerId             String?
  ownerType           MediaOwnerType
  itemId              String?
  dealMessageId       String?
  itemThreadMessageId String?
  url                 String
  key                 String?
  contentType         String
  sizeBytes           Int
  width               Int?
  height              Int?
  createdAt           DateTime       @default(now())

  owner             User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  item              Item?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dealMessage       DealMessage?       @relation("DealMessageMedia", fields: [dealMessageId], references: [id], onDelete: Cascade)
  itemThreadMessage ItemThreadMessage? @relation("ItemThreadMessageMedia", fields: [itemThreadMessageId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([itemId, createdAt])
  @@index([dealMessageId])
  @@index([itemThreadMessageId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ChatPreference {
  id        String   @id @default(cuid())
  userId    String
  kind      ChatKind
  entityId  String
  muted     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityId])
  @@index([userId, muted, updatedAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  targetType     ReportTargetType
  targetUserId   String?
  itemId         String?
  swapId         String?
  reason         ReportReason
  details        String?          @db.Text
  status         ReportStatus     @default(OPEN)
  resolvedById   String?
  resolutionNote String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  reporter   User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User?        @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  item       Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  swap       SwapRequest? @relation(fields: [swapId], references: [id], onDelete: SetNull)
  resolvedBy User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId, status])
  @@index([itemId, status])
  @@index([swapId, status])
}

model ProductEvent {
  id          String   @id @default(cuid())
  name        String
  actorId     String?
  anonymousId String?
  sessionId   String?
  entityType  String?
  entityId    String?
  path        String?
  properties  Json?
  dedupeKey   String?  @unique
  occurredAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([actorId, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([entityType, entityId])
  @@index([occurredAt])
}
