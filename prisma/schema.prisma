generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  THING
  SERVICE
}

enum ItemStatus {
  ACTIVE
  IN_DEAL
  ARCHIVED
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SWAP_RECEIVED
  SWAP_ACCEPTED
  SWAP_DECLINED
  SWAP_CANCELLED
  SWAP_COMPLETED
  DEAL_MESSAGE_RECEIVED
  ITEM_MESSAGE_RECEIVED
}

enum MediaOwnerType {
  ITEM
  USER
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  city          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  items         Item[]
  sentSwaps     SwapRequest[] @relation("SwapSender")
  receivedSwaps SwapRequest[] @relation("SwapReceiver")
  dealMessages  DealMessage[]
  itemThreadsAsBuyer  ItemThread[] @relation("ItemThreadBuyer")
  itemThreadsAsOwner  ItemThread[] @relation("ItemThreadOwner")
  itemMessages  ItemThreadMessage[]
  notifications Notification[]
  mediaAssets   MediaAsset[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id          String     @id @default(cuid())
  title       String
  type        ItemType
  category    String
  description String     @db.Text
  city        String
  isOnline    Boolean    @default(false)
  status      ItemStatus @default(ACTIVE)
  desired     String[]   @default([])
  acceptsAnything Boolean @default(false)
  extraOfferText  String? @db.Text
  ownerId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner         User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        MediaAsset[]
  sentSwaps     SwapRequest[] @relation("SenderItem")
  receivedSwaps SwapRequest[] @relation("ReceiverItem")
  threads       ItemThread[]

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@index([category, status])
  @@index([city, status])
  @@index([type, status])
}

model SwapRequest {
  id             String     @id @default(cuid())
  status         SwapStatus @default(PENDING)
  senderId       String
  receiverId     String
  senderItemId   String
  receiverItemId String
  senderCompleted   Boolean @default(false)
  receiverCompleted Boolean @default(false)
  acceptedAt     DateTime?
  pendingPairKey String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender       User @relation("SwapSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User @relation("SwapReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  senderItem   Item @relation("SenderItem", fields: [senderItemId], references: [id], onDelete: Restrict)
  receiverItem Item @relation("ReceiverItem", fields: [receiverItemId], references: [id], onDelete: Restrict)
  messages     DealMessage[]

  @@index([senderId, status, updatedAt])
  @@index([receiverId, status, updatedAt])
  @@index([senderItemId, status])
  @@index([receiverItemId, status])
  @@index([status, updatedAt])
}

model DealMessage {
  id        String   @id @default(cuid())
  swapId    String
  senderId  String
  text      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  swap   SwapRequest @relation(fields: [swapId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([swapId, createdAt])
  @@index([swapId, isRead, createdAt])
}

model ItemThread {
  id        String   @id @default(cuid())
  itemId    String
  buyerId   String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer    User @relation("ItemThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  owner    User @relation("ItemThreadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages ItemThreadMessage[]

  @@unique([itemId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([ownerId, updatedAt])
}

model ItemThreadMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  text      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread ItemThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, isRead, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  href       String?
  entityType String?
  entityId   String?
  isRead     Boolean @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model MediaAsset {
  id          String @id @default(cuid())
  ownerId     String?
  ownerType   MediaOwnerType
  itemId      String?
  url         String
  key         String?
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  item  Item? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([itemId, createdAt])
}
